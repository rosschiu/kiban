# Kiban zero-clone quickstart — environment. Copy to `.env` (same directory as
# docker-compose.yml), fill it in, then `docker compose up`. Never commit `.env`.
#
# Generating every secret below in one shot (run from this directory, after `cp .env.example
# .env`):
#
#   for k in POSTGRES_PASSWORD KIBAN_DB_PASSWORD KC_DB_PASSWORD KC_BOOTSTRAP_ADMIN_PASSWORD KEYCLOAK_IDENTITY_CLIENT_SECRET \
#            KIBAN_REGISTRY_DB_PASSWORD KIBAN_IDENTITY_DB_PASSWORD KIBAN_ORG_DB_PASSWORD \
#            KIBAN_AUTHZ_DB_PASSWORD KIBAN_NOTIFICATION_DB_PASSWORD KIBAN_TIMESHEET_DB_PASSWORD \
#            KIBAN_DOCS_DB_PASSWORD KIBAN_HELPDESK_DB_PASSWORD KIBAN_NOTIFICATION_WEBHOOK_HMAC_SECRET; do
#     sed -i "s|^${k}=\$|${k}=$(openssl rand -hex 24)|" .env
#   done
#
# That's the "generated-secrets instructions" this file promises — one command, every blank
# secret field filled with a fresh strong value. Re-running it is safe (sed's `=$` anchor only
# ever touches a field that's still blank).

# --- The one thing you MUST set: which published version to run ------------------------------
# See https://github.com/rosschiu/kiban/pkgs/container/kiban-gateway for available tags.
KIBAN_VERSION=v0.1.0

# --- Ports (127.0.0.1 only — never exposed beyond this host) ---------------------------------
POSTGRES_HOST_PORT=25432
KEYCLOAK_HOST_PORT=25081
# Deliberately 3000, not arbitrary — see README.md step 4: this is the port Keycloak's realm is
# pre-configured to allow an interactive browser OAuth login from.
# Remapping it breaks the browser login, and the realm has no direct-grant client to fall back to.
KIBAN_GATEWAY_HTTP_HOST_PORT=3000

# --- Postgres ----------------------------------------------------------------------------------
# POSTGRES_USER is the cluster superuser (initdb only); `kiban` (KIBAN_DB_PASSWORD) owns the app
# database and `keycloak` (KC_DB_PASSWORD) owns Keycloak's — both created at first start.
POSTGRES_USER=postgres
POSTGRES_DB=kiban
POSTGRES_PASSWORD=
KIBAN_DB_PASSWORD=
KC_DB_PASSWORD=

# --- Keycloak ------------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_REALM=kiban
KEYCLOAK_IDENTITY_CLIENT_SECRET=

# --- Per-service DB role passwords (one per foundation service + module) ---------------------
KIBAN_REGISTRY_DB_PASSWORD=
KIBAN_IDENTITY_DB_PASSWORD=
KIBAN_ORG_DB_PASSWORD=
KIBAN_AUTHZ_DB_PASSWORD=
KIBAN_NOTIFICATION_DB_PASSWORD=
KIBAN_TIMESHEET_DB_PASSWORD=
KIBAN_DOCS_DB_PASSWORD=
KIBAN_HELPDESK_DB_PASSWORD=
KIBAN_NOTIFICATION_WEBHOOK_HMAC_SECRET=

# --- Superadmin (non-secret identity fields only — the initial password is a FILE, never an env
# var; see README.md step 2) ---
KIBAN_SUPERADMIN_USERNAME=superadmin
KIBAN_SUPERADMIN_EMAIL=superadmin@kiban.local

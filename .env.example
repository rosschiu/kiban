# Kiban — the one environment file. Lives at the repository root as `.env` (gitignored).
#
# `make setup` copies this file to `.env` once and fills every GENERATED field with
# `openssl rand -hex 24`; it never rewrites an existing `.env`. Every `docker compose` call the
# Makefile makes passes `--env-file .env --project-directory infra`; `make test-stack-up` derives
# `.env.test` from `.env` (same values, four host ports remapped) for the isolated `kiban-test`
# project. No password has a default anywhere in infra/compose*.yaml.
#
# Each variable is one of:
#   REQUIRED   you must set it yourself before the command that needs it
#   GENERATED  blank here; `make setup` fills it (openssl rand -hex 24, 48 hex chars)
#   OPTIONAL   has a default; set it only for the reason given
#
# Lines that start with `#` are comments; commented-out variables (`#NAME=`) keep their compose
# default until you uncomment them. Never commit `.env` or `.env.test`.

# ============================================================================ Postgres
# postgres:18-alpine, stack-owned (never downgrade). Published on 127.0.0.1 only.

# OPTIONAL (default postgres). The cluster SUPERUSER. Used only by the image's initdb scripts
# (infra/postgres-init/*.sh, which create the two owner roles below) and by backup and restore
# tooling that genuinely needs it (pg_restore --disable-triggers, DROP/CREATE DATABASE); nothing
# that runs continuously connects as it. Never `kiban`: that name is the app-DB owner role.
POSTGRES_USER=postgres

# GENERATED. The superuser's password.
POSTGRES_PASSWORD=

# OPTIONAL (default kiban) — and in practice fixed: the shipped, checksum-frozen migrations name
# the database `kiban` by literal, so initdb refuses any other value.
POSTGRES_DB=kiban

# GENERATED. Password of `kiban`, the non-superuser owner of POSTGRES_DB (created at initdb).
# Migrations, bootstrap and scripts/set-role-password.sh connect as it.
KIBAN_DB_PASSWORD=

# GENERATED. Password of `keycloak`, the non-superuser owner of the `keycloak` database —
# Keycloak's own DB credential.
KC_DB_PASSWORD=

# OPTIONAL (default 5434). Host port Postgres is published on (127.0.0.1:<port>). Not 5432 so it
# does not collide with a Postgres already running on the host; `make migrate-*` and the Go test
# helpers connect through it. `make test-stack-up` remaps it to 15434 in `.env.test`.
POSTGRES_HOST_PORT=5434

# ============================================================================ Keycloak
# Keycloak image + realm import, plus the Java MFA-setup authenticator (infra/keycloak-build/).

# OPTIONAL (default 8081). Host port Keycloak HTTP is published on (127.0.0.1:<port>).
# `make test-stack-up` remaps it to 18081 in `.env.test`.
KEYCLOAK_HOST_PORT=8081

# OPTIONAL (default admin). Bootstrap admin account Keycloak creates on first start
# (KC_BOOTSTRAP_ADMIN_* env, Keycloak 26+). Only the keycloak container sees these as env vars;
# bootstrap reads the password as a compose secret file (infra/compose.yaml `secrets:`), so it
# never appears in `docker inspect` there.
KC_BOOTSTRAP_ADMIN_USERNAME=admin

# GENERATED. The bootstrap admin's password.
KC_BOOTSTRAP_ADMIN_PASSWORD=

# OPTIONAL (default kiban). Name of the realm imported at startup (definition rendered by
# infra/keycloak-build/start.sh). Also the realm bootstrap, identity and the gateway use.
KEYCLOAK_REALM=kiban

# GENERATED. Secret of the `kiban-identity-service` confidential client (service account,
# manage-users on this realm only — master-realm credentials are never used at runtime).
# Rendered into the imported realm JSON by keycloak-build/start.sh (JSON-escaped, any characters
# are fine). The identity service does NOT read this variable: bootstrap writes Keycloak's
# current value to its secrets volume and identity reads that file.
KEYCLOAK_IDENTITY_CLIENT_SECRET=

# ============================================================================ Per-service DB roles
# One Postgres role per service/module; each service's own migrations grant it privileges on
# its own schema only. `make migrate-registry` (and every `migrate` container run) applies the
# four foundation passwords via migrations/registry/set-role-passwords.sh; each module target
# sets its own via scripts/set-role-password.sh. All GENERATED.

# GENERATED. kiban_registry role (migrations/registry/0001_roles.sql).
KIBAN_REGISTRY_DB_PASSWORD=
# GENERATED. kiban_identity role.
KIBAN_IDENTITY_DB_PASSWORD=
# GENERATED. kiban_org role.
KIBAN_ORG_DB_PASSWORD=
# GENERATED. kiban_authz role.
KIBAN_AUTHZ_DB_PASSWORD=
# GENERATED. kiban_notification role (migrations/registry/0005_notification_role.sql).
KIBAN_NOTIFICATION_DB_PASSWORD=
# GENERATED. HMAC key the notification worker signs outbound webhook deliveries with
# (X-Kiban-Signature); receivers verify with the same value.
KIBAN_NOTIFICATION_WEBHOOK_HMAC_SECRET=
# GENERATED. kiban_timesheet role (migrations/registry/0008_timesheet_role.sql).
KIBAN_TIMESHEET_DB_PASSWORD=
# GENERATED. kiban_docs role (migrations/registry/0010_docs_role.sql).
KIBAN_DOCS_DB_PASSWORD=
# GENERATED. kiban_helpdesk role (migrations/registry/0012_helpdesk_role.sql).
KIBAN_HELPDESK_DB_PASSWORD=

# ============================================================================ Kiban
# The one-time superadmin bootstrap creates. Identity fields only: the initial PASSWORD is a
# 0600 file `make dev`/`make public-up` generate at infra/secrets-in/superadmin-password, never
# an environment variable (infra/compose.yaml `bootstrap` service).

# OPTIONAL (default superadmin). Review before a real deploy.
KIBAN_SUPERADMIN_USERNAME=superadmin
# OPTIONAL (default superadmin@kiban.local). Review before a real deploy.
KIBAN_SUPERADMIN_EMAIL=superadmin@kiban.local

# OPTIONAL (defaults 8443 / 8090). Host ports the gateway publishes its TLS and plain-HTTP
# listeners on (127.0.0.1 only). Leave unset for `make dev`: the live-stack guards
# (infra/proof-env.sh, internal/livestack, web/e2e-shared/env.ts) treat an absent line as 8443.
# `make test-stack-up` writes 18543 / 18100 into `.env.test`.
#KIBAN_GATEWAY_TLS_HOST_PORT=8443
#KIBAN_GATEWAY_HTTP_HOST_PORT=8090

# OPTIONAL. Compose project name — set it here (not as a shell export) to run a second
# instance from another clone on the same host, with its own port set above (the documentation's
# Operating page, "Running a second instance on the same host").
#COMPOSE_PROJECT_NAME=kiban

# OPTIONAL. Audience every service requires in a bearer token. The realm's audience mapper on
# the kiban-frontend client writes `kiban-api`, and infra/compose*.yaml do not pass this
# variable through (every service defaults to kiban-api); it only matters for a compose file of
# your own.
#KEYCLOAK_AUDIENCE=kiban-api

# OPTIONAL. Host name the gateway dials for module <KEY> (uppercased module key). infra/
# compose.yaml sets one per shipped module on the gateway service itself, not from this file;
# without it the gateway dials 127.0.0.1:<port>, which is not the module's container.
#KIBAN_MODULE_HOST_NOTIFICATION=notification

# KIBAN_IMAGE_TAG (deploy from images `make images` already built) and KIBAN_COMMIT are passed
# on the `make` command line, not set here: `KIBAN_IMAGE_TAG=v0.1.0 make dev`.

# ---------------------------------------------------------------------------- Public mode
# `make public-up` only (infra/compose.public.yaml): the stack sits behind the host's shared
# Traefik edge instead of publishing its own TLS port.

# REQUIRED for `make public-up` (unused by `make dev`). The hostname the edge serves, e.g.
# kiban.example.com — becomes the Keycloak issuer and the realm client's redirect origin.
#KIBAN_PUBLIC_HOST=kiban.example.com
# OPTIONAL. What bootstrap and the gateway read for the public origin: with it set, bootstrap
# reconciles the kiban-frontend client's redirect URIs and web origins to exactly
# https://<domain>/* on every run and the gateway allows that origin for CORS; unset, both use
# the fixed localhost set. infra/compose.public.yaml sets it on bootstrap from KIBAN_PUBLIC_HOST
# and infra/compose.yaml leaves it unset on purpose; neither reads it from this file. There is
# no variable for an extra origin.
#KIBAN_DOMAIN=kiban.example.com
# OPTIONAL. Comma-separated client ids. Bootstrap creates each as a confidential Keycloak client
# with a service account and the kiban-api audience, so a backend (a worker, a connector, a
# mailer) obtains its own token with the client-credentials grant. Read each secret from the
# Keycloak admin console (realm kiban, Clients, <id>, Credentials). The token's subject is the
# client's service-account user; add it to a company like any member to give it access.
#KIBAN_SERVICE_CLIENTS=tokidesk-worker,tokidesk-mailer
# OPTIONAL (default kiban-public). The external Docker network the shared edge is attached to.
#KIBAN_PUBLIC_NETWORK=kiban-public
